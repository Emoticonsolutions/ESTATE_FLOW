// Prisma Database Schema for EstateFlow CRM
// Multi-Tenant Real Estate CRM SaaS Architecture (Section 8)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TENANT & AUTHENTICATION
// ==========================================

model Company {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  logoUrl      String?
  plan         String    @default("Starter") // Starter, Professional, Enterprise
  status       String    @default("Active")  // Active, Suspended, Trial
  userLimit    Int       @default(5)
  projectLimit Int       @default(2)
  contactEmail String
  phone        String
  city         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  projects     Project[]
  leads        Lead[]
  units        Unit[]
  bookings     Booking[]
  payments     Payment[]
  brokers      Broker[]
  templates    MessageTemplate[]
  workflows    AutomationWorkflow[]
  auditLogs    AuditLog[]

  @@map("companies")
}

model User {
  id              String       @id @default(uuid())
  companyId       String
  name            String
  email           String       @unique
  passwordHash    String
  phone           String
  role            String       // SUPER_ADMIN, COMPANY_ADMIN, SALES_MANAGER, SALES_EXECUTIVE, ACCOUNTS_MANAGER, BROKER
  department      String
  designation     String
  status          String       @default("Active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedLeads   Lead[]       @relation("AssignedExecutive")
  managedLeads    Lead[]       @relation("AssignedManager")
  activities      LeadActivity[]

  @@index([companyId])
  @@map("users")
}

// ==========================================
// 2. PROJECTS, TOWERS & INVENTORY
// ==========================================

model Project {
  id              String    @id @default(uuid())
  companyId       String
  name            String
  code            String
  builderName     String
  category        String    // Residential, Commercial, Mixed
  type            String    // High-Rise, Luxury Villas, Gated Community, Plots
  location        String
  city            String
  state           String
  pincode         String
  reraNumber      String
  launchDate      DateTime
  possessionDate  DateTime
  status          String    // Pre-Launch, Under Construction, Ready to Move
  totalLandArea   String
  baseRatePerSqFt Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  towers          Tower[]
  units           Unit[]
  leads           Lead[]
  bookings        Booking[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("projects")
}

model Tower {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  code          String
  totalFloors   Int
  unitsPerFloor Int
  totalUnits    Int
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors        Floor[]
  units         Unit[]

  @@index([projectId])
  @@map("towers")
}

model Floor {
  id             String    @id @default(uuid())
  towerId        String
  floorNumber    Int
  floorLabel     String
  floorRisePrice Decimal   @default(0) @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tower          Tower     @relation(fields: [towerId], references: [id], onDelete: Cascade)

  @@index([towerId])
  @@map("floors")
}

model Unit {
  id                 String    @id @default(uuid())
  companyId          String
  projectId          String
  towerId            String
  floorNumber        Int
  unitNumber         String
  unitType           String    // 1 BHK, 2 BHK, 3 BHK, 4 BHK, Penthouse
  carpetArea         Decimal   @db.Decimal(10, 2)
  builtUpArea        Decimal   @db.Decimal(10, 2)
  superBuiltUpArea   Decimal   @db.Decimal(10, 2)
  balconyArea        Decimal   @db.Decimal(10, 2)
  facing             String    // East, North, North-East, West, South
  basePrice          Decimal   @db.Decimal(14, 2)
  floorRiseRate      Decimal   @default(0) @db.Decimal(10, 2)
  plcRate            Decimal   @default(0) @db.Decimal(10, 2)
  parkingCharges     Decimal   @default(0) @db.Decimal(10, 2)
  clubhouseCharges   Decimal   @default(0) @db.Decimal(10, 2)
  maintenanceCharges Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("Available") // Available, Blocked, Reserved, Booked, Sold, On Hold
  blockedUntil       DateTime?
  blockedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tower              Tower     @relation(fields: [towerId], references: [id], onDelete: Cascade)
  bookings           Booking[]

  @@unique([projectId, towerId, unitNumber])
  @@index([companyId, status])
  @@map("units")
}

// ==========================================
// 3. LEAD MANAGEMENT & ACTIVITIES
// ==========================================

model Lead {
  id                     String    @id @default(uuid())
  companyId              String
  leadNumber             String    @unique
  fullName               String
  mobile                 String
  alternateMobile        String?
  email                  String
  city                   String
  state                  String
  preferredContactMethod String    // Phone, WhatsApp, Email
  
  interestedProjectId    String
  propertyType           String
  configuration          String
  budgetMin              Decimal   @db.Decimal(10, 2)
  budgetMax              Decimal   @db.Decimal(10, 2)
  preferredFloor         String?
  purpose                String    // End-use, Investment
  possessionPreference   String    // Ready to Move, Under Construction

  source                 String    // Meta, Google Ads, 99acres, Broker Referral, Walk-in
  campaign               String?
  priority               String    // Hot, Warm, Cold, Qualified
  assignedManagerId      String?
  assignedExecutiveId    String?
  status                 String    @default("New") // New, Contacted, Qualified, Interested, Site Visit Scheduled, Site Visit Completed, Negotiation, Booked, Lost
  aiScore                Int       @default(50)
  notes                  String?
  nextFollowUpDate       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                Project   @relation(fields: [interestedProjectId], references: [id])
  assignedExecutive      User?     @relation("AssignedExecutive", fields: [assignedExecutiveId], references: [id])
  assignedManager        User?     @relation("AssignedManager", fields: [assignedManagerId], references: [id])
  activities             LeadActivity[]
  followUps              FollowUp[]
  bookings               Booking[]

  @@index([companyId, status])
  @@index([companyId, mobile])
  @@map("leads")
}

model LeadActivity {
  id          String    @id @default(uuid())
  leadId      String
  userId      String?
  type        String    // Call, Meeting, Note, Email, WhatsApp, Site Visit, Status Change
  title       String
  description String
  createdAt   DateTime  @default(now())

  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activities")
}

model FollowUp {
  id              String    @id @default(uuid())
  companyId       String
  leadId          String
  assignedToId    String
  type            String    // Phone Call, WhatsApp, Email, Meeting, Site Visit
  dateTime        DateTime
  remarks         String
  isCompleted     Boolean   @default(false)
  completionNotes String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, isCompleted, dateTime])
  @@map("follow_ups")
}

// ==========================================
// 4. BOOKINGS, PAYMENTS & AUDIT TRAIL
// ==========================================

model Booking {
  id                   String    @id @default(uuid())
  companyId            String
  bookingNumber        String    @unique
  projectId            String
  unitId               String
  leadId               String
  customerName         String
  customerMobile       String
  customerEmail        String
  agreedPrice          Decimal   @db.Decimal(14, 2)
  bookingAmount        Decimal   @db.Decimal(14, 2)
  paymentPlan          String
  salesExecutiveName   String
  brokerId             String?
  status               String    @default("Pending Approval") // Draft, Pending Approval, Approved, Confirmed, Cancelled
  bookingDate          DateTime  @default(now())
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project              Project   @relation(fields: [projectId], references: [id])
  unit                 Unit      @relation(fields: [unitId], references: [id])
  lead                 Lead      @relation(fields: [leadId], references: [id])
  payments             Payment[]

  @@index([companyId, status])
  @@map("bookings")
}

model Payment {
  id              String    @id @default(uuid())
  companyId       String
  bookingId       String
  receiptNumber   String    @unique
  customerName    String
  unitNumber      String
  amount          Decimal   @db.Decimal(14, 2)
  paymentMethod   String    // Bank Transfer, UPI, Cheque, Gateway
  referenceNumber String
  paymentDate     DateTime  @default(now())
  status          String    @default("Confirmed")
  receivedBy      String
  createdAt       DateTime  @default(now())

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking         Booking   @relation(fields: [bookingId], references: [id])

  @@index([companyId, bookingId])
  @@map("payments")
}

model Broker {
  id                   String    @id @default(uuid())
  companyId            String
  name                 String
  agencyName           String
  reraRegistration     String
  mobile               String
  email                String
  city                 String
  commissionPercentage Decimal   @db.Decimal(5, 2)
  status               String    @default("Active")
  createdAt            DateTime  @default(now())

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("brokers")
}

model MessageTemplate {
  id        String    @id @default(uuid())
  companyId String
  channel   String    // WhatsApp, Email
  title     String
  category  String
  content   String
  approved  Boolean   @default(true)
  createdAt DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("message_templates")
}

model AutomationWorkflow {
  id        String    @id @default(uuid())
  companyId String
  name      String
  trigger   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("automation_workflows")
}

model AuditLog {
  id          String    @id @default(uuid())
  companyId   String?
  userId      String?
  action      String
  module      String
  ipAddress   String?
  userAgent   String?
  details     String
  createdAt   DateTime  @default(now())

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

