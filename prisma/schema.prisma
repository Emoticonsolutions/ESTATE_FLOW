// Prisma Schema for EstateFlow Multi-Tenant Real Estate CRM SaaS
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Developer Companies (Multi-Tenant Isolation)
model Company {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  logo               String?
  plan               String   @default("Professional") // Starter, Professional, Enterprise
  status             String   @default("Active")       // Active, Suspended, Trial
  userLimit          Int      @default(20)
  projectLimit       Int      @default(10)
  contactEmail       String
  phone              String
  city               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Statutory Registrations (India Compliance)
  registrationNumber String?  // CIN / ROC
  cin                String?
  reraNumber         String?  // State RERA Promoter ID
  gstin              String?  // 15-digit GSTIN
  panNumber          String?
  address            String?
  state              String?
  pincode            String?

  // SaaS Billing
  monthlyFee         Float    @default(34999)
  billingCycle       String   @default("Monthly")
  nextRenewalDate    String?
  paymentStatus      String   @default("Paid") // Paid, Pending, Overdue
  adminName          String?
  adminEmail         String?

  // Relations
  users              User[]
  projects           Project[]
  units              Unit[]
  leads              Lead[]
  bookings           Booking[]
  payments           PaymentRecord[]
  brokers            Broker[]
  invoices           SaaSInvoice[]

  @@map("companies")
}

// 2. Users & Stakeholder RBAC Personas
model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String?
  password         String   @default("admin123")
  role             String   // SUPER_ADMIN, COMPANY_ADMIN, SALES_MANAGER, SALES_EXECUTIVE, ACCOUNTS_MANAGER, BROKER
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       String?  @default("Operations")
  designation      String?  @default("Executive")
  avatar           String?
  status           String   @default("Active")
  assignedProjects String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

// 3. Real Estate Projects / Portfolios
model Project {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  code           String
  location       String
  city           String
  reraNumber     String?
  status         String   @default("Active") // Planning, Under Construction, Ready to Move, Sold Out
  totalUnits     Int      @default(100)
  availableUnits Int      @default(80)
  launchDate     String?
  completionDate String?
  towers         Tower[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("projects")
}

// 4. Property Towers
model Tower {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  floorsCount   Int      @default(14)
  unitsPerFloor Int      @default(4)
  units         Unit[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("towers")
}

// 5. Units / Apartments (with Transactional Blocking)
model Unit {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  towerId            String
  tower              Tower     @relation(fields: [towerId], references: [id], onDelete: Cascade)
  unitNumber         String
  floorNumber        Int
  configuration      String    // 1 BHK, 2 BHK, 3 BHK, 4 BHK, Villa, Penthouse
  superBuiltUpArea   Float
  carpetArea         Float
  facing             String    @default("North") // North, South, East, West, Park View
  baseRatePerSqFt    Float     @default(7500)
  totalCost          Float
  status             String    @default("Available") // Available, Blocked, Reserved, Booked, Sold
  blockedBy          String?
  blockedUntil       DateTime?
  ownerCustomerName  String?
  ownerMobile        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@map("units")
}

// 6. Omni-Channel Leads
model Lead {
  id                     String     @id @default(cuid())
  leadNumber             String     @unique
  companyId              String
  company                Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName               String
  mobile                 String
  alternateMobile        String?
  email                  String?
  city                   String?
  preferredContactMethod String     @default("Phone")
  interestedProjectId    String?
  propertyType           String?    @default("Apartment")
  configuration          String?    @default("3 BHK")
  budgetMin              Float?     @default(100)
  budgetMax              Float?     @default(160)
  source                 String     @default("Website Form")
  priority               String     @default("Warm") // Hot, Warm, Cold
  status                 String     @default("New")  // New, Contacted, Site Visit Scheduled, Site Visit Completed, Negotiation, Booked, Lost
  aiScore                Int        @default(75)     // 0 - 100
  notes                  String?
  assignedExecutiveId    String?
  assignedManagerId      String?
  nextFollowUpDate       String?
  followUps              FollowUp[]
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("leads")
}

// 7. Follow-Up Schedule
model FollowUp {
  id              String    @id @default(cuid())
  companyId       String
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  type            String    @default("Phone Call") // Phone Call, WhatsApp, Meeting, Site Visit
  executiveName   String
  notes           String?
  isCompleted     Boolean   @default(false)
  completionNotes String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@map("follow_ups")
}

// 8. Confirmed Unit Bookings
model Booking {
  id                  String          @id @default(cuid())
  bookingNumber       String          @unique
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit            @relation(fields: [unitId], references: [id])
  customerName        String
  customerMobile      String
  customerEmail       String
  customerPan         String?
  totalAgreementValue Float
  bookingAmountPaid   Float
  paymentPlan         String          @default("Construction Linked Plan (CLP)")
  status              String          @default("Approved") // Draft, Pending Approval, Approved, Confirmed, Cancelled
  bookingDate         String
  payments            PaymentRecord[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("bookings")
}

// 9. Payment Transactions & Receipts
model PaymentRecord {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingId      String?
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerName   String
  amountPaid     Float
  paymentMode    String   @default("RTGS") // RTGS, NEFT, Cheque, UPI, Razorpay
  transactionRef String?
  paymentDate    String
  status         String   @default("Confirmed")
  createdAt      DateTime @default(now())

  @@map("payments")
}

// 10. Channel Partner Brokers
model Broker {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  firmName          String
  reraNumber        String
  mobile            String
  email             String?
  tier              String   @default("Gold") // Platinum, Gold, Silver
  commissionRate    Float    @default(2.5)
  totalBookingsDone Int      @default(0)
  status            String   @default("Active")
  createdAt         DateTime @default(now())

  @@map("brokers")
}

// 11. SaaS Monthly Invoices
model SaaSInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName   String
  planName      String
  billingPeriod String
  baseAmount    Float
  gstAmount     Float
  totalAmount   Float
  dueDate       String
  paidDate      String?
  status        String   @default("Paid") // Paid, Pending, Overdue
  paymentMethod String   @default("Razorpay Auto-Debit")
  paymentRef    String?
  cin           String?
  reraNumber    String?
  gstin         String?
  createdAt     DateTime @default(now())

  @@map("saas_invoices")
}
